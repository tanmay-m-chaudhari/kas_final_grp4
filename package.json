{
  "name": "notification-platform",
  "version": "1.0.0",
  "main": "dist/src/api/server.js",
  "scripts": {
    "start:api": "node dist/src/api/server.js",
    "start:worker:email": "node dist/src/workers/email/index.js",
    "start:worker:report": "node dist/src/workers/report/index.js",
    "dev:api": "ts-node-dev --respawn src/api/server.ts",
    "dev:worker:email": "ts-node-dev --respawn src/workers/email/index.ts",
    "dev:worker:report": "ts-node-dev --respawn src/workers/report/index.ts",
    "build": "tsc"
  },
  "dependencies": {
    "express": "^4.18.2",
    "bullmq": "^5.1.5",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "nodemailer": "^6.9.8",
    "pdfkit": "^0.14.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0",
    "date-fns": "^3.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.13.3",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node-dev": "^2.0.0"
  }
}
